  <diagram id="retrieval" name="09 Recuperação de evidência — pipeline">
    <mxGraphModel dx="756" dy="563" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="570" background="#0b1326" math="0" shadow="0">
