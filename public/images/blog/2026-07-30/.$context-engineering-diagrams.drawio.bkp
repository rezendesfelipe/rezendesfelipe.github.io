        <mxCell id="band1" value="Contexto de trabalho&#xa;objetivo, instruções e evidência da decisão atual" style="rounded=1;html=1;fillColor=#222a3d;strokeColor=#2fd9f4;strokeWidth=2;fontColor=#dae2fd;align=left;spacingLeft=20;" parent="1" vertex="1">
