  <diagram id="compression" name="10 Compressão e retenção — árvore de decisão">
    <mxGraphModel dx="1262" dy="621" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="600" background="#0b1326" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Compressão é decisão de arquitetura, não apenas redução de texto" style="text;html=1;fontSize=28;fontStyle=1;fontFamily=Space Grotesk;fontColor=#dae2fd;align=left;" parent="1" vertex="1">
          <mxGeometry x="60" y="60" width="1000" height="40" as="geometry" />
        </mxCell>
        <mxCell id="panel" value="" style="rounded=1;arcSize=5;html=1;fillColor=#171f33;strokeColor=#45464d;" parent="1" vertex="1">
          <mxGeometry x="60" y="125" width="1080" height="430" as="geometry" />
        </mxCell>
        <mxCell id="input" value="Informação de entrada&#xa;novo conteúdo a incorporar" style="rounded=1;html=1;fillColor=#222a3d;strokeColor=#2fd9f4;strokeWidth=2;fontColor=#dae2fd;" parent="1" vertex="1">
          <mxGeometry x="490" y="136" width="200" height="64" as="geometry" />
        </mxCell>
        <mxCell id="decision" value="Critério de retenção?" style="rhombus;html=1;fillColor=#222a3d;strokeColor=#8dc63f;strokeWidth=2;fontColor=#dae2fd;" parent="1" vertex="1">
          <mxGeometry x="515" y="250" width="150" height="84" as="geometry" />
        </mxCell>
        <mxCell id="summarize" value="Resumir&#xa;critério: alta frequência, baixa criticidade&#xa;reduz volume, perde o detalhe literal" style="rounded=1;html=1;fillColor=#222a3d;strokeColor=#7bd0ff;fontColor=#dae2fd;" parent="1" vertex="1">
          <mxGeometry x="90" y="360" width="300" height="130" as="geometry" />
        </mxCell>
        <mxCell id="structured" value="Manter estruturado&#xa;critério: precisa ser consultado e atualizado&#xa;vira estado, não texto livre" style="rounded=1;html=1;fillColor=#222a3d;strokeColor=#8dc63f;fontColor=#dae2fd;" parent="1" vertex="1">
          <mxGeometry x="440" y="360" width="300" height="130" as="geometry" />
        </mxCell>
        <mxCell id="pointer" value="Manter integralmente + ponteiro&#xa;critério: exige auditoria ou citação literal&#xa;fonte original acessível sob demanda" style="rounded=1;html=1;fillColor=#222a3d;strokeColor=#2fd9f4;strokeWidth=2;fontColor=#dae2fd;" parent="1" vertex="1">
          <mxGeometry x="790" y="360" width="300" height="130" as="geometry" />
        </mxCell>
        <mxCell id="di" style="html=1;endArrow=block;strokeColor=#2fd9f4;exitX=0.5;exitY=0;" parent="1" source="input" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="590" y="249" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="d1" style="html=1;endArrow=block;strokeColor=#2fd9f4;exitX=0;exitY=0.5;entryX=0.5;entryY=0;" parent="1" source="decision" target="summarize" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="d2" style="html=1;endArrow=block;strokeColor=#2fd9f4;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" parent="1" source="decision" target="structured" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="d3" style="html=1;endArrow=block;strokeColor=#2fd9f4;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" parent="1" source="decision" target="pointer" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="note" value="A escolha entre resumir, estruturar ou preservar depende de frequência, criticidade e necessidade de auditoria." style="text;html=1;fontColor=#c6c6cd;fontSize=13;align=left;" parent="1" vertex="1">
          <mxGeometry x="90" y="515" width="1000" height="24" as="geometry" />
        </mxCell>
      </root>
