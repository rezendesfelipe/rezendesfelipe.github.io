<mxfile host="app.diagrams.net" version="26.1.1" pages="1"><diagram id="params-stacks" name="Parâmetros → Stacks → tfstate"><mxGraphModel dx="1262" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="660" background="#0b1326" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="f1" value="Quem roda é decidido no run, o isolamento é decidido no desenho" style="text;html=1;align=left;verticalAlign=middle;fontSize=28;fontStyle=1;fontColor=#dae2fd;fontFamily=Space Grotesk;" vertex="1" parent="1"><mxGeometry x="60" y="52" width="1100" height="40" as="geometry"/></mxCell><mxCell id="f2" value="&lt;b style=&quot;font-family:Space Grotesk;color:#2fd9f4;font-size:12px&quot;&gt;PARÂMETROS DO RUN&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;environment&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#7bd0ff&quot;&gt;dev | hml | prod&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;instance&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#7bd0ff&quot;&gt;brs-01&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;action&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#7bd0ff&quot;&gt;plan | apply&lt;/font&gt;" style="rounded=1;arcSize=3;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=24;spacingTop=18;fillColor=#171f33;strokeColor=#45464d;fontColor=#dae2fd;fontFamily=Manrope;fontSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="130" width="300" height="410" as="geometry"/></mxCell><mxCell id="f3" value="☑ vnet-core" style="rounded=1;arcSize=20;html=1;whiteSpace=wrap;align=left;spacingLeft=20;verticalAlign=middle;fillColor=#222a3d;strokeColor=#2fd9f4;strokeWidth=2;fontColor=#dae2fd;fontFamily=Space Grotesk;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="84" y="340" width="252" height="48" as="geometry"/></mxCell><mxCell id="f4" value="☑ aks-core" style="rounded=1;arcSize=20;html=1;whiteSpace=wrap;align=left;spacingLeft=20;verticalAlign=middle;fillColor=#222a3d;strokeColor=#2fd9f4;s