        <mxCell id="title" value="Quem roda é decidido no run, o isolamento é decidido no desenho" style="text;html=1;fontSize=28;fontStyle=1;fontFamily=Space Grotesk;fontColor=#dae2fd;align=left;" parent="1" vertex="1"><mxGeometry x="60" y="60" width="1000" height="40" as="geometry" /></mxCell>
        <mxCell id="params" value="PARÂMETROS DO RUN&#xa;&#xa;environment: dev | hml | prd&#xa;action: plan | apply&#xa;&#xa;☑ network&#xa;☐ data&#xa;☑ aks" style="rounded=1;arcSize=5;html=0;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=24;spacingTop=18;fillColor=#171f33;strokeColor=#45464d;fontColor=#dae2fd;fontFamily=Manrope;fontSize=14;" parent="1" vertex="1"><mxGeometry x="60" y="130" width="300" height="400" as="geometry" /></mxCell>
        <mxCell id="pipe" value="PIPELINE ÚNICO&#xa;&#xa;Orquestração: lê os parâmetros e monta só os stages pedidos&#xa;&#xa;Template de stack: init → plan → (aprovação) → apply&#xa;&#xa;Identidade por ambiente: OIDC, sem segredo armazenado" style="rounded=1;arcSize=5;html=0;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=24;spacingRight=16;spacingTop=18;fillColor=#171f33;strokeColor=#2fd9f4;strokeWidth=2;fontColor=#dae2fd;fontFamily=Manrope;fontSize=14;" parent="1" vertex="1"><mxGeometry x="420" y="130" width="230" height="400" as="geometry" /></mxCell>
